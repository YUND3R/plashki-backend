# Скопируй в .env (не коммить .env).
# Локально: cp .env.example .env
# Test VPS (GitHub secret TEST_ENV_FILE): блок «TEST VPS» ниже
# Production (GitHub secret PROD_ENV_FILE): блок «PRODUCTION» ниже

# --- LOCAL (по умолчанию) ---
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://plashki:plashki@localhost:5432/plashki
POSTGRES_USER=plashki
POSTGRES_PASSWORD=plashki
POSTGRES_DB=plashki
EXPOSE_OPENAPI=true
# JWT_SECRET_KEY=local-dev-only-change-me-32-chars-min
# CORS_ORIGINS=http://localhost:5173

# --- TEST VPS (docker-compose.test.yml, ветка dev) ---
# ENVIRONMENT=development
# API_PORT=8000
# POSTGRES_USER=plashki
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=plashki
# PUBLIC_BASE_URL=http://YOUR_IP:8000
# CORS_ORIGINS=http://YOUR_IP:5173,http://localhost:5173
# FRONTEND_VERIFY_EMAIL_URL=http://YOUR_IP:5173/verify-email
# FRONTEND_RESET_PASSWORD_URL=http://YOUR_IP:5173/reset-password
# JWT_SECRET_KEY=change-me-min-32-chars
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_SAMESITE=lax
# EXPOSE_OPENAPI=true

# --- PRODUCTION (docker-compose.prod.yml) ---
# GHCR_IMAGE=org/plashki-api
# IMAGE_TAG=latest
# ENVIRONMENT=production
# EXPOSE_OPENAPI=false
# PUBLIC_BASE_URL=https://api.example.com
# CORS_ORIGINS=https://app.example.com
# FRONTEND_VERIFY_EMAIL_URL=https://app.example.com/verify-email
# FRONTEND_RESET_PASSWORD_URL=https://app.example.com/reset-password
# SECRET_KEY=change-me-min-32-chars
# AUTH_COOKIE_SECURE=true

# --- Опционально ---
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASSWORD= SMTP_FROM_EMAIL=
# NANOBANANA_API_KEY= NANOBANANA_BASE_URL=
