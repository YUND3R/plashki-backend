# Скопируй в .env (не коммить .env).
# Локально: cp .env.example .env
# Test VPS: весь блок «TEST VPS» → GitHub secret TEST_ENV_FILE (environment test)
# Production: блок «PRODUCTION» → GitHub secret PROD_ENV_FILE

# --- LOCAL (по умолчанию) ---
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://plashki:plashki@localhost:5432/plashki
POSTGRES_USER=plashki
POSTGRES_PASSWORD=plashki
POSTGRES_DB=plashki
EXPOSE_OPENAPI=true
# JWT_SECRET_KEY=local-dev-only-change-me-32-chars-min
# CORS_ORIGINS=http://localhost:5173

# --- TEST VPS (docker-compose.test.yml, ветка dev, домен plash-ki.ru) ---
# Скопируй блок ниже в GitHub → Settings → Secrets → TEST_ENV_FILE
# Замени CHANGE_ME_POSTGRES_PASSWORD и CHANGE_ME_JWT_SECRET на реальные значения с сервера.
#
# ENVIRONMENT=development
# API_PORT=8000
#
# POSTGRES_USER=plashki
# POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
# POSTGRES_DB=plashki
# DATABASE_URL=postgresql+asyncpg://plashki:CHANGE_ME_POSTGRES_PASSWORD@db:5432/plashki
#
# PUBLIC_BASE_URL=https://api.plash-ki.ru
# CORS_ORIGINS=https://plash-ki.ru,https://www.plash-ki.ru
# FRONTEND_VERIFY_EMAIL_URL=https://plash-ki.ru/verify-email
# FRONTEND_RESET_PASSWORD_URL=https://plash-ki.ru/reset-password
#
# JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
# AUTH_COOKIE_DOMAIN=.plash-ki.ru
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=lax
# EXPOSE_OPENAPI=false
#
# UPLOAD_DIR=uploads
# UPLOAD_MAX_MB=5

# --- PRODUCTION (docker-compose.prod.yml) ---
# GHCR_IMAGE=org/plashki-api
# IMAGE_TAG=latest
# ENVIRONMENT=production
# EXPOSE_OPENAPI=false
# PUBLIC_BASE_URL=https://api.plash-ki.ru
# CORS_ORIGINS=https://plash-ki.ru,https://www.plash-ki.ru
# FRONTEND_VERIFY_EMAIL_URL=https://plash-ki.ru/verify-email
# FRONTEND_RESET_PASSWORD_URL=https://plash-ki.ru/reset-password
# SECRET_KEY=change-me-min-32-chars
# AUTH_COOKIE_SECURE=true

# --- Опционально ---
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASSWORD= SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=Plashki
# SMTP_REPLY_TO_EMAIL=support@plash-ki.ru
# EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=10
# EMAIL_CHANGE_TOKEN_TTL_MINUTES=10
# NANOBANANA_API_KEY= NANOBANANA_BASE_URL=

# --- Фронт (отдельный репозиторий, .env.production) ---
# VITE_API_BASE_URL=https://api.plash-ki.ru
