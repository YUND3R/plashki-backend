# Окружение: local | development | production
# В production dev-эндпоинты /dev/* отключены.
ENVIRONMENT=local

# Обязательно задай для development/production (local: можно не задавать — подставится дефолт ниже).
# Локально (хост подключается к Postgres на localhost):
DATABASE_URL=postgresql+asyncpg://plashki:plashki@localhost:5432/plashki

# Docker Compose (API в сети compose, хост БД — имя сервиса db):
# DATABASE_URL=postgresql+asyncpg://plashki:ВАШ_ПАРОЛЬ@db:5432/plashki

# Учётные данные Postgres (сервис db в docker-compose)
POSTGRES_USER=plashki
POSTGRES_PASSWORD=plashki
POSTGRES_DB=plashki

# CORS: через запятую, без пробелов или с пробелами у строки. Пусто = middleware не вешается.
# CORS_ORIGINS=https://app.example.com,http://localhost:5173

# В production обычно false (Swagger/Redoc снаружи не светить).
EXPOSE_OPENAPI=true

# Секрет для будущих JWT / подписей (в production рекомендуется >= 32 символа, сгенерируй случайную строку).
# JWT_SECRET_KEY=
# или
# SECRET_KEY=

# Загрузка фото: каталог (относительно рабочей директории процесса), лимит МБ, публичный префикс URL за reverse proxy
# UPLOAD_DIR=uploads
# UPLOAD_MAX_MB=5
# PUBLIC_BASE_URL=https://api.example.com
# (нужен для абсолютной ссылки подтверждения email в письме, если не задан FRONTEND_VERIFY_EMAIL_URL)

# URL страницы восстановления пароля: в письме ссылка с #rid=<uuid>&sig=<hmac>
# FRONTEND_RESET_PASSWORD_URL=https://app.example.com/reset-password
# RESET_TOKEN_TTL_MINUTES=30

# URL страницы подтверждения email: в письме ссылка с #vid=<uuid>&sig=<hmac> (или API: .../auth/verify-email/<uuid>/<sig>)
# FRONTEND_VERIFY_EMAIL_URL=https://app.example.com/verify-email
# EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440

# SMTP для писем (регистрация, сброс пароля). Без SMTP_HOST + SMTP_FROM_EMAIL письма не уходят — смотрите логи api.
# Gmail/Yandex: часто 587 + STARTTLS (SMTP_USE_TLS=true) или 465 + SSL (SMTP_PORT=465).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=mailer@example.com
# SMTP_PASSWORD=super-secret
# SMTP_FROM_EMAIL=no-reply@example.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# Алертинг
# ALERT_EMAIL_TO=devops@example.com,lead@example.com
# TELEGRAM_BOT_TOKEN=123456:ABCDEF
# TELEGRAM_ALERT_CHAT_ID=-1001234567890
