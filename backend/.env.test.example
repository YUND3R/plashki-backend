# =============================================================================
# Plashki — тестовый деплой на VPS (HTTP, без домена)
# =============================================================================
# 1. cp .env.test.example .env
# 2. Замените YOUR_SERVER_IP на IP или sslip.io-хост VPS
# 3. CORS_ORIGINS — origin фронтенда (не API!)
# 4. docker compose -f docker-compose.test.yml up -d --build
#
# ENVIRONMENT=development → /dev/* включены (создание admin). Не для публичного prod!
# =============================================================================

ENVIRONMENT=development
API_PORT=8000

# --- Postgres (только внутри docker-сети, порт наружу не пробрасывается) ---
POSTGRES_USER=plashki
POSTGRES_PASSWORD=change-me-test-db-password
POSTGRES_DB=plashki

# --- Публичные URL (замените YOUR_SERVER_IP) ---
PUBLIC_BASE_URL=http://YOUR_SERVER_IP:8000
CORS_ORIGINS=http://YOUR_SERVER_IP:5173,http://YOUR_SERVER_IP:3000,http://localhost:5173

# Ссылки в письмах (если SMTP не настроен — можно оставить; verify через /dev/* или API)
FRONTEND_VERIFY_EMAIL_URL=http://YOUR_SERVER_IP:5173/verify-email
FRONTEND_RESET_PASSWORD_URL=http://YOUR_SERVER_IP:5173/reset-password

# --- Auth (HTTP: secure cookie выключен) ---
JWT_SECRET_KEY=replace-with-random-string-at-least-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
EXPOSE_OPENAPI=true

# --- SMTP (опционально; без SMTP регистрация работает, письма не уходят) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=mailer@example.com
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=no-reply@example.com
# SMTP_USE_TLS=true

# --- Nano Banana (опционально) ---
# NANOBANANA_API_KEY=
# NANOBANANA_BASE_URL=
