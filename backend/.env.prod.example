# -----------------------------
# Docker compose (production)
# -----------------------------
GHCR_IMAGE=your-github-org-or-user/plashki-api
IMAGE_TAG=latest
API_PORT=8000

POSTGRES_USER=plashki
POSTGRES_PASSWORD=change-me
POSTGRES_DB=plashki

# -----------------------------
# Backend runtime config
# -----------------------------
ENVIRONMENT=production
EXPOSE_OPENAPI=false
PUBLIC_BASE_URL=https://api.example.com
FRONTEND_RESET_PASSWORD_URL=https://app.example.com/reset-password
FRONTEND_VERIFY_EMAIL_URL=https://app.example.com/verify-email

# Security (required in production)
SECRET_KEY=replace-with-strong-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=plashki_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Mail (optional but recommended)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=mailer@example.com
# SMTP_PASSWORD=super-secret
# SMTP_FROM_EMAIL=no-reply@example.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# Feedback notifications (optional)
# ALERT_EMAIL_TO=support@example.com
# TELEGRAM_BOT_TOKEN=123456:ABCDEF
# TELEGRAM_ALERT_CHAT_ID=-1001234567890
